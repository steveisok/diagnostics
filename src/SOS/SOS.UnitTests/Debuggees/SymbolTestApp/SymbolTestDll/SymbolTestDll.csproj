<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework Condition="'$(BuildProjectFramework)' != ''">$(BuildProjectFramework)</TargetFramework>
    <TargetFrameworks Condition="'$(BuildProjectFramework)' == '' and '$(OS)' != 'windows'">$(SupportedSubProcessTargetFrameworks)</TargetFrameworks>
    <TargetFrameworks Condition="'$(BuildProjectFramework)' == '' and '$(OS)' == 'windows'">$(DesktopTargetFramework);$(SupportedSubProcessTargetFrameworks)</TargetFrameworks>
  </PropertyGroup>
</Project>
